SHELL := /bin/bash

COMPOSE := docker compose
DB_SERVICE := postgres
DB_TIMEOUT := 60

.ONESHELL:
.PHONY: all test prepare generate build up wait-db down clean

all: test

# Runs the complete test lifecycle, including cleanup on failure or interruption.
test:
	set -Eeuo pipefail
	trap '$(MAKE) down' EXIT
	$(MAKE) prepare
	go test -v ./tests/...

prepare: clean generate build up wait-db

generate:
	sqlc generate

build:
	go build ./...

up:
	$(COMPOSE) up -d --remove-orphans

wait-db:
	for attempt in $$(seq 1 $(DB_TIMEOUT)); do
		if $(COMPOSE) exec -T $(DB_SERVICE) sh -c 'pg_isready -U "$${POSTGRES_USER:-postgres}" -d "$${POSTGRES_DB:-db}"' >/dev/null 2>&1; then
			echo "PostgreSQL está listo."
			exit 0
		fi
		sleep 5
	done
	echo "PostgreSQL no estuvo disponible después de $(DB_TIMEOUT) segundos." >&2
	$(COMPOSE) logs $(DB_SERVICE)
	exit 1

down:
	$(COMPOSE) down --volumes --remove-orphans

clean: down
