package views

templ ErrorAlert(mensaje string) {
	<article
		role="alert"
		style="border-left: 4px solid #c0392b; background-color: #fdf2f2; color: #922b21; padding: 0.75rem 1rem; margin-bottom: 1rem;"
	>
		<strong>Error:</strong> { mensaje }
	</article>
}

templ ClearError() {
	<div id="mensaje-error" hx-swap-oob="true"></div>
}
